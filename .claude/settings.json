{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Agent",
      "NotebookEdit",
      "TodoWrite",
      "mcp__claude_ai_Canva",
      "mcp__claude_ai_Google_Drive",
      "mcp__claude-in-chrome"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(Remove-Item:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)",
      "mcp__plugin_playwright_playwright"
    ],
    "defaultMode": "acceptEdits"
  },
  "model": "opus",
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "high",
    "PYTHONUTF8": "1",
    "HF_HUB_DISABLE_SYMLINKS_WARNING": "1"
  }
}
