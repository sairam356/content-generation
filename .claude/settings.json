{
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(py:*)",
      "Bash(.venv\\Scripts\\python.exe:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(yt-dlp:*)",
      "Bash(dir:*)",
      "Bash(ls:*)",
      "Bash(type:*)",
      "Bash(cat:*)",
      "Bash(move:*)",
      "Bash(copy:*)",
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Agent",
      "Edit(analytics/**)",
      "Edit(community/**)",
      "Edit(topics/**)",
      "Edit(inbox/**)",
      "Edit(ready/**)",
      "Edit(memory/**)",
      "Edit(assets/music/**)",
      "mcp__claude-in-chrome__*"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(Remove-Item:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)"
    ]
  },
  "model": "opus",
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "high",
    "PYTHONUTF8": "1",
    "HF_HUB_DISABLE_SYMLINKS_WARNING": "1"
  }
}
