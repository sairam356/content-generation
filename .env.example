# ---- Gemini (video understanding + Telugu script) ----
GEMINI_API_KEY=
# gemini-flash-latest is the safe default; gemini-2.5-pro gives better scripts if your key has access
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# replicate = same idea/transcript/shots/timing as the reference, only face+voice swapped; remix = original re-explanation
SCRIPT_MODE=replicate

# ---- ElevenLabs (your cloned voice, Telugu TTS) ----
ELEVENLABS_API_KEY=
# filled automatically by:  python -m pipeline voice clone
ELEVENLABS_VOICE_ID=
# eleven_v4 = best clone accuracy + Telugu. Fallback: eleven_v3
ELEVENLABS_MODEL=eleven_v4
# deep | clean | none  (ffmpeg mastering preset applied to every narration file)
VOICE_ENHANCE_PRESET=deep

# ---- Higgsfield (used by Claude Code through the Higgsfield CLI / MCP) ----
# Soul ID of your face. Filled after:  higgsfield soul-id create --name me ...
HIGGSFIELD_SOUL_ID=

# ---- Pipeline ----
# default length budget for the Telugu short, seconds
TARGET_DURATION_SEC=45
# Windows font that has Telugu glyphs (Nirmala UI ships with Windows 10/11)
SUBTITLE_FONT=Nirmala UI

# --- Local (free) renderer: python -m pipeline render ---
# Gemini image models for b-roll frames, tried in order
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image,gemini-3-pro-image-preview
# Wav2Lip downscale factor for your base video (2 = half size, much faster on CPU / 2 GB GPUs)
WAV2LIP_RESIZE=2
WAV2LIP_BATCH=16
# presenter picture-in-picture corner for presenter_overlay scenes: left | right
OVERLAY_POS=left

# gemini (needs paid Gemini image quota) | pollinations (free, no key). Gemini falls back to pollinations automatically.
IMAGE_PROVIDER=elevenlabs

# ElevenLabs speaking rate 0.7-1.2 (reference channels talk fast)
VOICE_SPEED=1.1

# B-roll: elevenlabs = real AI video (Veo 3.1 via ElevenLabs credits, default when ELEVENLABS_API_KEY is set) | none = still images
VIDEO_PROVIDER=elevenlabs
XI_VIDEO_MODEL=veo-3.1-fast-generate-001,creatify-aurora
XI_VIDEO_RES=720p
# Images: elevenlabs (Gemini 3.1 image via ElevenLabs credits, default) | gemini | pollinations (free, watermark)
# Presenter lips: elevenlabs (creatify-aurora from one still of you, default with key) | wav2lip (free, local)
PRESENTER_PROVIDER=elevenlabs
