# AI backgrounds behind you (Veo 3.1 clips billed to your ElevenLabs credits). Leave empty = presenter only.
ELEVENLABS_API_KEY=
BROLL_PROVIDER=elevenlabs          # elevenlabs | pollinations (free stills) | none
XI_VIDEO_MODEL=veo-3.1-fast-generate-001,veo-3.1-generate-001
XI_VIDEO_RES=720p

# Optional: /ref lets Gemini watch a reference Short (free AI Studio key). Without it, /ref uses yt-dlp + Whisper.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest

# Local
WHISPER_MODEL=small                # tiny|base|small|medium (CPU)
SUBTITLE_FONT=Nirmala UI
PROMPTER_SPEED=55
PROMPTER_FONT=54
